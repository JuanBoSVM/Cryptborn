<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/_Project/UI/Styles/USS_Menu.uss?fileID=7433441132597879392&amp;guid=0ef0e218ed7bf9e448f5202d412219df&amp;type=3#USS_Menu" />
    <ui:Style src="project://database/Assets/_Project/UI/Styles/USS_Menu_Settings.uss" />
    <ui:VisualElement name="Body" class="container">
        <ui:Label text="Settings" name="Title" />
        <ui:VisualElement name="Main" class="container" style="flex-grow: 1;">
            <ui:VisualElement class="settings-row">
                <ui:Label text="Global Audio" class="settings-label" />
                <ui:Slider name="GlobalAudio" low-value="0" high-value="1" value="1" class="settings-slider" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="Music Audio" class="settings-label" />
                <ui:Slider name="MusicAudio" low-value="0" high-value="1" value="1" class="settings-slider" />
            </ui:VisualElement>
            <ui:VisualElement class="settings-row">
                <ui:Label text="SFX Audio" class="settings-label" />
                <ui:Slider name="SFXAudio" low-value="0" high-value="1" value="1" class="settings-slider" />
            </ui:VisualElement>
            <ui:Button text="Back" name="Back" />
        </ui:VisualElement>
        <ui:VisualElement name="Selectors">
            <ui:Image name="Left" source="project://database/Assets/_Project/Art/Textures/UI/Dividers/TEX_Divider_Fade_00.png?fileID=2800000&amp;guid=d8f2816538c346f4e845bb68ff6ba1c7&amp;type=3#TEX_Divider_Fade_00" />
            <ui:Image name="Right" source="project://database/Assets/_Project/Art/Textures/UI/Dividers/TEX_Divider_Fade_00.png?fileID=2800000&amp;guid=d8f2816538c346f4e845bb68ff6ba1c7&amp;type=3#TEX_Divider_Fade_00" style="scale: -1 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>