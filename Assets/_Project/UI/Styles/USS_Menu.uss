Button {
    background-image: url("project://database/Assets/_Project/Art/Textures/UI/Borders/TEX_Panel_Border_05.png?fileID=2800000&guid=489fc879b171e1f44a5d0c50c4d7e40e&type=3#TEX_Panel_Border_05");
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    -unity-font-definition: resource("Fonts/Font Assets/FA_SDF_KenneySpace");
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 25px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    transition-timing-function: ease-in-out;
    transition-duration: 0.3s;
    flex-basis: 15%;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    padding-top: 2%;
    padding-right: 5%;
    padding-bottom: 2%;
    padding-left: 5%;
    margin-top: 0%;
    margin-right: 2%;
    margin-bottom: 0%;
    margin-left: 2%;
}

.container {
    margin-top: 2%;
    margin-right: 2%;
    margin-bottom: 2%;
    margin-left: 2%;
    height: 100%;
}

#Body {
    background-image: url("project://database/Assets/_Project/Art/Textures/UI/Panels/Transparent%20Center/TEX_Panel_Transparent_Center_00.png?fileID=2800000&guid=3cf54d0608456324e92cd3d1336d7df5&type=3#TEX_Panel_Transparent_Center_00");
    padding-bottom: 2%;
    padding-top: 2%;
    padding-right: 24%;
    padding-left: 24%;
    background-size: contain;
    -unity-slice-left: 32;
    -unity-slice-top: 32;
    -unity-slice-right: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 2px;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

#Title {
    width: 100%;
    height: 20%;
    padding-left: 5%;
    padding-right: 5%;
    padding-top: 0%;
    padding-bottom: 0%;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    -unity-font-definition: resource("Fonts/Font Assets/FA_SDF_KenneySpace");
    -unity-text-align: middle-center;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 100px;
    color: rgb(255, 255, 255);
}

#Main {
    align-items: center;
    justify-content: space-evenly;
    align-content: center;
}

#Selectors {
    opacity: 0;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

#Selectors > Image {
    position: absolute;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    opacity: 0.8;
}
